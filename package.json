{
    "name": "@navikt/astro-logger",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "description": "A custom logger for Astro 7 that emits Nav/Grafana-friendly JSON logs, mirroring @navikt/pino-logger.",
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com/"
    },
    "files": [
      "dist",
      "package.json",
      "README.md"
    ],
    "engines": {
        "node": "^20.19.0 || >= 22.12.0 || 24.x"
    },
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./team-log": "./dist/team-log/index.js"
    },
    "scripts": {
        "build": "tsup",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "astro": "^7.0.0",
        "pino": "8 || 9 || 10"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.9.0"
    },
    "optionalDependencies": {
        "pino-socket": "7.4.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.9",
        "astro": "^7.0.0",
        "pino": "^10.2.0",
        "rimraf": "^6.0.1",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    }
}
